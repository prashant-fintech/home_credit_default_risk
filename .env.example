DATA_DIR=data/raw
PROCESSED_DIR=data/processed
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MODEL_REGISTRY_NAME=home-credit-lgbm

# Load CSVs from S3 instead of local disk (leave blank to use DATA_DIR)
S3_DATA_URI=s3://home-credit-default-risk-405894863747/raw

# Load CSVs from Azure Data Lake Storage Gen2 instead (wins over S3_DATA_URI). Needs `az login`.
# Value is written to infra/azure/.env.azure by infra/azure/provision.sh
AZURE_DATA_URI=
